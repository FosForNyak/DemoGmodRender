#pragma code_page(65001)
// Ресурси програми: іконка, маніфест (DPI, UTF-8), інформація про версію.
#include <winver.h>

101 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "042204B0"
        BEGIN
            VALUE "FileDescription", "GMod Demo Render"
            VALUE "ProductName", "GMod Demo Render"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0422, 1200
    END
END
